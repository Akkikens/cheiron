# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value below is a safe default except
# OPENAI_API_KEY, which is required only when LLM_ENABLED=true.
# ---------------------------------------------------------------------------

# Leave blank to run in degraded mode (SPEC §5.5 heuristic planner only).
OPENAI_API_KEY=

# false => the service runs with no API key present at all (SPEC §5.5, A6).
LLM_ENABLED=true

CTG_BASE_URL=https://clinicaltrials.gov/api/v2

# Per-request wall clock and upstream courtesy budgets (SPEC §7).
REQUEST_BUDGET_MS=10000
MAX_UPSTREAM_REQUESTS=40
MAX_CONCURRENCY=8

# total <= this => complete_records mode; above it => counts/sampled (SPEC §5.2).
RECORD_MODE_THRESHOLD=2000
